# Built before creating the internal runtime network. Runtime serves no app.
FROM oven/bun:1.3.10 AS bun
FROM node:22-bookworm-slim
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
WORKDIR /e2e
COPY e2e/package.json e2e/bun.lock ./
RUN bun install --frozen-lockfile \
    && node node_modules/@playwright/test/cli.js install --with-deps chromium
COPY e2e/challenge-image.config.ts ./
# Only the dedicated suite's actual local dependency graph.
COPY e2e/helpers/challenge-image-fixtures.ts e2e/helpers/oauth.ts e2e/helpers/challenge-image-rpc.ts e2e/helpers/challenge-image-summary.ts ./helpers/
COPY e2e/challenge-image/ ./challenge-image/
COPY core/tests/fixtures/challenges/v1/events.json /core/tests/fixtures/challenges/v1/events.json
CMD ["sleep", "infinity"]
